# =========================================================
# DC-IOC 后端环境变量模板 (复制为 .env 并修改)
# =========================================================

# ---------- 应用 ----------
APP_NAME=DC-IOC Platform
APP_ENV=dev                    # dev / staging / prod
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=120
LOG_LEVEL=INFO

# ---------- PostgreSQL ----------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=dcuser
POSTGRES_PASSWORD=dcpass
POSTGRES_DB=dc_ioc
# 或直接覆盖完整连接串 (优先):
# DATABASE_URL=postgresql+psycopg://dcuser:dcpass@127.0.0.1:5432/dc_ioc

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
# 或完整连接串:
# REDIS_URL=redis://:password@127.0.0.1:6379/0

# ---------- Celery (任务队列, 复用 Redis) ----------
CELERY_BROKER_URL=redis://127.0.0.1:6379/2
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/3

# ---------- CORS (前端地址) ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 实时推送 ----------
WS_PATH=/ws
METRIC_PUSH_INTERVAL=3        # 秒, 遥测推送周期

# ---------- 第三方/采集 (可选) ----------
# MODBUS_GATEWAY=127.0.0.1:502
# SNMP_COMMUNITY=public

# ---------- AI 运维助手 · Dify RAG 检索层 (可选) ----------
# 配置后, 知识库检索优先走 Dify Knowledge API (向量召回 top-k), 失败回退本地关键词打分。
# 生成仍走现有 NIM 小模型 (LLM_*), Dify 仅做检索编排。
# DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx
# DIFY_BASE_URL=http://localhost:5001/v1
# DIFY_DATASET_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Dify 平台 API Tool 回调本项目后端时携带的 Bearer Token (与 Dify 侧配置一致)
# DIFY_TOOL_KEY=change-me-dify-tool-token
# DIFY_RETRIEVE_TOP_K=5
