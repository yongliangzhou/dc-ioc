{
  "name": "dc-ioc-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build --emptyOutDir=false",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "generate:api": "orval",
    "prepare": "cd .. && husky frontend/.husky || true"
  },
  "dependencies": {
    "@dc-ioc/ui": "file:../packages/dc-ioc-ui",
    "axios": "^1.7.9",
    "dayjs": "^1.11.13",
    "echarts": "^5.6.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^2.3.1",
    "three": "^0.169.0",
    "vue": "^3.5.13",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^16.4.0",
    "orval": "^7.6.0",
    "prettier": "^3.9.6",
    "sass": "^1.84.0",
    "typescript": "~5.7.3",
    "unplugin-auto-import": "^19.0.0",
    "unplugin-vue-components": "^28.0.0",
    "vite": "^6.1.0",
    "vite-plugin-compression2": "^2.5.3",
    "vitest": "^3.0.5",
    "vue-tsc": "^2.2.8"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "0.25.12"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
