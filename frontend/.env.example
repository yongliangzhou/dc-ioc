# =========================================================
# DC-IOC 前端环境变量模板 (复制为 .env.development / .env.production)
# Vite 仅暴露以 VITE_ 开头的变量
# =========================================================

# 后端 API 基础地址
# 开发模式 (Vite proxy): 留空即可，Vite 会将 /api 代理到后端
# 生产模式: 设置为后端完整地址，如 http://localhost:8000/api/v1
VITE_API_BASE_URL=

# WebSocket 遥测地址
# 开发模式: 留空走 Vite proxy
VITE_WS_URL=

# 应用标题
VITE_APP_TITLE=DC-IOC 智能运营中心

# 刷新周期 (毫秒)
VITE_REFRESH_INTERVAL=3000
