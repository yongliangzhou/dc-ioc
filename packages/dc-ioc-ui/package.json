{
  "name": "@dc-ioc/ui",
  "version": "0.1.0",
  "description": "DC IOC Platform shared UI component library",
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/dc-ioc-ui.umd.cjs",
  "module": "./dist/dc-ioc-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/dc-ioc-ui.js",
      "require": "./dist/dc-ioc-ui.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly --outDir dist",
    "type-check": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.8"
  }
}
